<?xml version="1.0" encoding="utf-8"?>
<!-- Branded launch background: app-scaffold dark + centered radar mark.
     Android 12+ ignores this and uses the SplashScreen API (styled via
     values-v31/styles.xml); this covers pre-31 devices. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item android:gravity="center">
        <bitmap android:src="@drawable/splash_mark" />
    </item>
</layer-list>
